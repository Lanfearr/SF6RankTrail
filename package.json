{
  "name": "sf6scorer",
  "version": "1.3.0",
  "description": "Real-time Street Fighter 6 LP/MR trend tracker with OBS overlay",
  "main": "./out/main/index.js",
  "private": true,
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "dist": "electron-vite build && electron-builder --config.electronDist=node_modules/electron/dist",
    "spike:m0": "tsx spike/m0.ts",
    "spike:selftest": "tsx spike/m0.ts --self-test",
    "spike:dbtest": "tsx spike/db-selftest.ts",
    "spike:migtest": "tsx spike/migration-selftest.ts",
    "spike:m1test": "tsx spike/m1-selftest.ts",
    "spike:uitest": "tsx spike/ui-selftest.ts",
    "spike:updatetest": "tsx spike/update-selftest.ts",
    "spike:netcheck": "electron spike/electron-fetch-check.cjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.18.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitejs/plugin-react": "^6.2.1",
    "echarts": "^5.5.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
